{
  "formatVersion": 2,
  "club": "KYC",
  "name": "Sovereign's Cup 2025 RTC/Coastal courses",
  "source": "https://www.kyc.ie/wp-content/uploads/2025/06/SOVS_2025_SIS_v6.pdf",
  "marks": "marks.json",
  "startLine": {
    "id": "SL",
    "name": "Start line",
    "placement": "The starting line will be between a Red & White Pole on the Committee Vessel and a Mark (or a vessel displaying an orange flag) at the port end. An IDM may be laid off the Committee Vessel and boats shall not pass between the CV and the IDM when starting. The location of the start will be advised over Ch72 at 10.00 hrs and at suitable intervals prior to the Warning Signal on each day of racing.",
    "source": "Sovereign's Cup 2025 sailing instructions FB 2.1 and 2.2"
  },
  "notes": [
    {
      "title": "FB 3 COURSES",
      "text": "3.1 Coastal Courses\na. Coastal Classes 1 & 2 may sail a course as listed within these SIs. In addition, the RO may advise, prior to the warning signal, of any\nb. amendment to the course chosen or of a new course not listed. In this circumstance the RO will broadcast the course to be sailed on VHF 72 at least 5 minutes before the warning signal.\n3.2 Spinnaker Class 3\na. Will sail either a laid course as outlined in FA 3.2 (see Page 8) OR an RTC/Coastal course chosen from those within these SI’s.\nb. In addition, the RO may advise, prior to the warning signal, of any amendment to the course chosen or of a new course not listed. In this circumstance the RO will broadcast the course to be sailed on VHF 72 at least 5 minutes before the warning signal."
    },
    {
      "title": "FB 4 MARKS",
      "text": "The Kinsale Yacht Club permanently laid racing marks (yellow conical with a dayglo flag) and local navigation marks as far East as Cork Buoy and as far West as Black Tom (see Courtmacsherry Bay) will be used as racing marks on the Coastal/Round the Cans courses."
    },
    {
      "title": "FB 6 FINISHING LINE",
      "text": "Unless the course is shortened, the finishing line will be between the red and white pole on the Committee Boat and an adjacent mark. This changes RRS race signals ‘finish’."
    },
    {
      "title": "FC 3 COURSES",
      "text": "3.1 Non Spinnaker Courses\na. RTC courses as listed within these SIs.\nb. In addition, the RO may advise, prior to the warning signal, of any amendment to the course chosen or of a new course not listed. In this circumstance the RO will broadcast the course to be sailed on VHF 71 at least 5 minutes before the warning signal."
    },
    {
      "title": "FC 6 FINISHING LINE",
      "text": "Unless the course is shortened, the finishing line will be between the red and white pole on the Committee Boat and an adjacent Dann Buoy. This changes RRS race signals ‘finish’."
    }
  ],
